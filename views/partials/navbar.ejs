<header>
    <div class="topbar">
        <div class="container topbar-container">
            <div class="topbar-contact">
                <a href="<%= site.waLink %>" target="_blank" rel="noopener" class="wpr-button"><i class="fa-brands fa-whatsapp"></i> <%= site.phoneDisplay %></a>
                <a href="mailto:<%= site.emailSupport %>"><i class="fa-solid fa-envelope"></i> <%= site.emailSupport %></a>
            </div>
        </div>
    </div>

    <nav class="navbar">
        <div class="container navbar-container">
            <div class="navbar-left">
                <a href="/" class="logo">
                    <img src="/images/logo.png" alt="EuroPower">
                </a>

                <ul class="nav-menu">
                    <li><a href="/layanan-kami" class="<%= currentPath === '/layanan-kami' ? 'active' : '' %>">Solusi Kami</a></li>
                    <li><a href="https://europower.co.id/blog/">Wawasan</a></li>
                    <li><a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Kontak</a></li>
                </ul>
            </div>

            <button class="nav-toggle" id="navToggle" aria-label="Buka menu" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>

            <div class="nav-collapse" id="navCollapse">
                <div class="nav-mobile-contact">
                    <a href="<%= site.waLink %>" target="_blank" rel="noopener" class="wpr-button"><i class="fa-brands fa-whatsapp"></i> <%= site.phoneDisplay %></a>
                    <a href="mailto:<%= site.emailSupport %>"><i class="fa-solid fa-envelope"></i> <%= site.emailSupport %></a>
                </div>

                <div class="nav-right">
                    <div class="language">
                        <a href="#" id="langId" class="active">
                            <img src="/images/id.jpeg" alt="ID" class="flag-img">
                            <span>ID</span>
                        </a>
                        <span class="divider">|</span>
                        <a href="#" id="langEn">
                            <img src="/images/en.jpeg" alt="EN" class="flag-img">
                            <span>EN</span>
                        </a>
                    </div>
                    <a href="<%= site.waLink %>" target="_blank" rel="noopener" class="btn-primary wpr-button">
                        <i class="fa-brands fa-whatsapp"></i>
                        Hubungi Kami
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>
